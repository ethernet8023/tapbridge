+            for p in &scene.paths[range.clone()] {
+                add(p.bounds);
+            }
+        }
+        PrimitiveBatch::Underlines(range) => {
+            for p in &scene.underlines[range.clone()] {
+                add(p.bounds);
+            }
+        }
+        PrimitiveBatch::PolychromeSprites { range, .. } => {
+            for p in &scene.polychrome_sprites[range.clone()] {
+                add(p.bounds);
+            }
+        }
+        PrimitiveBatch::MonochromeSprites { range, .. } => {
+            for p in &scene.monochrome_sprites[range.clone()] {
+                if p.transformation != gpui::TransformationMatrix::unit() {
+                    *d = full;
+                    return;
+                }
+                add(p.bounds);
+            }
+        }
+        PrimitiveBatch::SubpixelSprites { range, .. } => {
+            for p in &scene.subpixel_sprites[range.clone()] {
+                if p.transformation != gpui::TransformationMatrix::unit() {
+                    *d = full;
+                    return;
+                }
+                add(p.bounds);
+            }
+        }
+        _ => *d = full,
+    }
+}
