<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Virtual FIDO security key (IOHIDUserDevice). Restricted: needs an
         Apple-approved provisioning profile; ad-hoc builds only run with
         AMFI disabled. -->
    <key>com.apple.developer.hid.virtual.device</key>
    <true/>
</dict>
</plist>
